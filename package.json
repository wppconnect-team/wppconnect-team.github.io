    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-sass": "^0.2.7",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-feather": "^2.0.10",
    "react-is": "^19.3.1",
    "redocusaurus": "^2.5.2",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-styled-components": "^2.3.1",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.2.0"
