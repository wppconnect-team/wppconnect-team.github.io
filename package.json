{
  "name": "wppconnect-team-github-io",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "crowdin": "crowdin",
    "crowdin:sync": "docusaurus write-translations && crowdin upload && crowdin download",
    "deploy": "docusaurus deploy",
    "docusaurus": "docusaurus",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "swizzle": "docusaurus swizzle",
    "typecheck": "tsc",
    "wa-version:download": "curl -s https://raw.githubusercontent.com/wppconnect-team/wa-version/main/versions.json -o src/pages/whatsapp-versions/versions.json",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations",
    "test:dependencies": "node --test --test-timeout=20000 .github/actions/dependencies.test.cjs",
    "test:dev": "node .github/actions/smoke-dev.cjs"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@crowdin/cli": "^5.5.0",
    "@docusaurus/core": "^3.10.2",
