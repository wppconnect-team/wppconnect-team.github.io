{
  "version": 2,
  "source": {
    "website": "https://wppconnect.io/",
    "repository": "https://github.com/wppconnect-team/wppconnect-team.github.io",
    "path": "design-system/tokens.json",
    "profile": "Shared website and Cloud: quiet light surfaces and restrained motion"
  },
  "primitive": {
    "green": {
      "$type": "color",
      "$value": "#25d366"
    },
    "green-accessible": {
      "$type": "color",
      "$value": "#11763a"
    },
    "green-light": {
      "$type": "color",
      "$value": "#34d978"
    },
    "cyan": {
      "$type": "color",
      "$value": "#22d3ee"
    },
    "violet": {
      "$type": "color",
      "$value": "#8b5cf6"
    },
    "pink": {
      "$type": "color",
      "$value": "#ec4899"
    },
    "canvas-light": {
      "$type": "color",
      "$value": "#fafbfc"
    },
    "elevated-light": {
      "$type": "color",
      "$value": "#f1f4f8"
    },
    "surface-light": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "text-light": {
      "$type": "color",
      "$value": "#0a0c12"
    },
    "muted-light": {
      "$type": "color",
      "$value": "#475569"
    },
    "border-light": {
      "$type": "color",
      "$value": "#e1e5eb"
    },
    "input-light": {
      "$type": "color",
      "$value": "#b6c0cc"
    },
    "canvas-dark": {
      "$type": "color",
      "$value": "#07080a"
    },
    "elevated-dark": {
      "$type": "color",
      "$value": "#0c0d10"
    },
    "surface-dark": {
      "$type": "color",
      "$value": "#111114"
    },
    "text-dark": {
      "$type": "color",
      "$value": "#e7e7ea"
    },
    "muted-dark": {
      "$type": "color",
      "$value": "#9a9aa3"
    },
    "border-dark": {
      "$type": "color",
      "$value": "#292a30"
    },
    "input-dark": {
      "$type": "color",
      "$value": "#484951"
    },
    "danger-light": {
      "$type": "color",
      "$value": "#b4232d"
    },
    "danger-dark": {
      "$type": "color",
      "$value": "#ff939b"
    },
    "space-1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "space-6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "space-8": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "space-12": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "radius": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "control-height": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
    "control-touch-height": {
      "$type": "dimension",
      "$value": "2.75rem"
    },
    "duration-fast": {
      "$type": "duration",
      "$value": "150ms"
    }
  },
  "semantic": {
    "light": {
      "background": "{primitive.canvas-light}",
      "foreground": "{primitive.text-light}",
      "card": "{primitive.surface-light}",
      "card-foreground": "{primitive.text-light}",
      "popover": "{primitive.surface-light}",
      "popover-foreground": "{primitive.text-light}",
      "primary": "{primitive.text-light}",
      "primary-foreground": "{primitive.surface-light}",
      "secondary": "{primitive.elevated-light}",
      "secondary-foreground": "{primitive.text-light}",
      "muted": "{primitive.elevated-light}",
      "muted-foreground": "{primitive.muted-light}",
      "accent": "{primitive.elevated-light}",
      "accent-foreground": "{primitive.text-light}",
      "brand": "{primitive.green-accessible}",
      "brand-solid": "{primitive.green}",
      "brand-on": "{primitive.canvas-dark}",
      "success": "{primitive.green-accessible}",
      "destructive": "{primitive.danger-light}",
      "destructive-foreground": "{primitive.surface-light}",
      "border": "{primitive.border-light}",
      "input": "{primitive.input-light}",
      "ring": "{primitive.muted-light}",
      "sidebar": "{primitive.elevated-light}",
      "sidebar-foreground": "{primitive.text-light}",
      "sidebar-primary": "{primitive.text-light}",
      "sidebar-primary-foreground": "{primitive.surface-light}",
      "sidebar-accent": "{primitive.border-light}",
      "sidebar-accent-foreground": "{primitive.text-light}",
      "sidebar-border": "{primitive.border-light}",
      "sidebar-ring": "{primitive.muted-light}",
      "code": "{primitive.elevated-dark}",
      "code-foreground": "{primitive.text-dark}",
      "code-muted": "{primitive.muted-dark}",
      "code-accent": "{primitive.green-light}",
      "code-border": "{primitive.border-dark}",
      "chart-1": "{primitive.green-accessible}",
      "chart-2": "{primitive.muted-light}",
      "chart-3": "{primitive.violet}",
      "chart-4": "{primitive.text-light}",
      "chart-5": "{primitive.input-light}"
    },
    "dark": {
      "background": "{primitive.canvas-dark}",
      "foreground": "{primitive.text-dark}",
      "card": "{primitive.surface-dark}",
      "card-foreground": "{primitive.text-dark}",
      "popover": "{primitive.surface-dark}",
      "popover-foreground": "{primitive.text-dark}",
      "primary": "{primitive.text-dark}",
      "primary-foreground": "{primitive.canvas-dark}",
      "secondary": "{primitive.elevated-dark}",
      "secondary-foreground": "{primitive.text-dark}",
      "muted": "{primitive.elevated-dark}",
      "muted-foreground": "{primitive.muted-dark}",
      "accent": "{primitive.border-dark}",
      "accent-foreground": "{primitive.text-dark}",
      "brand": "{primitive.green-light}",
      "brand-solid": "{primitive.green}",
      "brand-on": "{primitive.canvas-dark}",
      "success": "{primitive.green-light}",
      "destructive": "{primitive.danger-dark}",
      "destructive-foreground": "{primitive.canvas-dark}",
      "border": "{primitive.border-dark}",
      "input": "{primitive.input-dark}",
      "ring": "{primitive.muted-dark}",
      "sidebar": "{primitive.elevated-dark}",
      "sidebar-foreground": "{primitive.text-dark}",
      "sidebar-primary": "{primitive.text-dark}",
      "sidebar-primary-foreground": "{primitive.canvas-dark}",
      "sidebar-accent": "{primitive.border-dark}",
      "sidebar-accent-foreground": "{primitive.text-dark}",
      "sidebar-border": "{primitive.border-dark}",
      "sidebar-ring": "{primitive.muted-dark}",
      "code": "{primitive.elevated-dark}",
      "code-foreground": "{primitive.text-dark}",
      "code-muted": "{primitive.muted-dark}",
      "code-accent": "{primitive.green-light}",
      "code-border": "{primitive.border-dark}",
      "chart-1": "{primitive.green-light}",
      "chart-2": "{primitive.muted-dark}",
      "chart-3": "{primitive.cyan}",
      "chart-4": "{primitive.text-dark}",
      "chart-5": "{primitive.input-dark}"
    }
  },
  "component": {
    "radius": "{primitive.radius}",
    "control-height": "{primitive.control-height}",
    "control-touch-height": "{primitive.control-touch-height}",
    "button-bg": "var(--primary)",
    "button-fg": "var(--primary-foreground)",
    "button-brand-bg": "var(--brand-solid)",
    "button-brand-fg": "var(--brand-on)",
    "field-bg": "var(--card)",
    "field-border": "var(--input)",
    "field-ring": "var(--ring)",
    "panel-bg": "var(--card)",
    "panel-border": "var(--border)",
    "font-body": "var(--font-geist-sans), Arial, sans-serif",
    "font-heading": "var(--font-geist-sans), Arial, sans-serif",
    "font-code": "var(--font-geist-mono), monospace",
    "focus-width": "2px",
    "focus-offset": "3px",
    "transition-fast": "{primitive.duration-fast}"
  }
}
