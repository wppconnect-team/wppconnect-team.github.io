{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // Disable the inherited option removed in TypeScript 7.
    "baseUrl": null,
    "resolveJsonModule": true,
    "paths": { "@site/*": ["./*"] },
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["src", "*.js"]
}
